# Contoh konfigurasi — SALIN ke .env lalu isi nilai asli.
# JANGAN commit file .env yang sudah diisi ke GitHub.

# --- Database (Supabase Postgres, production) ---
# Format: postgresql+psycopg2://postgres:<PASSWORD>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+psycopg2://postgres:ganti-dengan-password@db.contoh.supabase.co:5432/postgres

# --- JWT (backend) ---
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRE_MINUTES=720

# --- Supabase (frontend memakai ANON key saja) ---
SUPABASE_URL=https://contoh.supabase.co
SUPABASE_ANON_KEY=ganti-dengan-anon-key
# Service role HANYA untuk backend darurat, jangan taruh di frontend:
# SUPABASE_SERVICE_ROLE_KEY=ganti-dengan-service-role-key

# --- Bootstrap owner pertama (sekali pakai saat DB masih kosong) ---
BOOTSTRAP_OWNER_EMAIL=owner@contoh.com
BOOTSTRAP_OWNER_PASSWORD=ganti-dengan-password-kuat

# --- Aturan bisnis ---
ALLOW_NEGATIVE_STOCK=false

# --- CORS ---
CORS_ORIGINS=*
